<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="593.0" prefWidth="777.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.vivero.controlador.Controlador.Vivero">
   <children>
      <TableView fx:id="tablaPlantas" layoutX="343.0" layoutY="71.0" prefHeight="343.0" prefWidth="396.0">
        <columns>
          <TableColumn fx:id="tipoMostrado" prefWidth="75.0" text="Tipo" />
            <TableColumn fx:id="nombreMostrado" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="AlturaMostrada" prefWidth="75.0" text="Altura(cm)" />
            <TableColumn fx:id="cantidadMostrada" prefWidth="75.0" text="Cantidad" />
            <TableColumn fx:id="precioMostrado" prefWidth="95.0" text="Precio unitario" />
        </columns>
      </TableView>
      <VBox fx:id="vBoxComun" layoutX="26.0" layoutY="54.0" prefHeight="182.0" prefWidth="181.0">
         <children>
            <ComboBox fx:id="tipoPlanta" onAction="#mostrarTipo" prefWidth="150.0" promptText="Tipo de planta" />
            <Label layoutX="10.0" layoutY="10.0" text="Nombre" />
            <TextField fx:id="nombrePlanta" layoutX="10.0" layoutY="27.0" text="Ej: Helecho" />
            <Label layoutX="10.0" layoutY="52.0" text="Altura" />
            <TextField fx:id="alturaPlanta" layoutX="10.0" layoutY="69.0" text="Altura en cm 1 entre 300" />
            <Label layoutX="10.0" layoutY="94.0" text="Cantidad" />
            <TextField fx:id="cantidad" layoutX="10.0" layoutY="111.0" text="Entre 1 y 300" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Tipo Planta" />
                  <CheckBox fx:id="filtroPlantaInterior" mnemonicParsing="false" onAction="#filtroInterior" text="Interior" />
                  <CheckBox fx:id="filtroPlantaExterior" mnemonicParsing="false" onAction="#filtroExterior" text="Exterior" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Button fx:id="registroPlanta" layoutX="32.0" layoutY="456.0" mnemonicParsing="false" onAction="#registrodePlanta" text="Registrar" />
      <Button fx:id="eliminarPlanta" layoutX="680.0" layoutY="414.0" mnemonicParsing="false" onAction="#eliminarP" text="Eliminar" />
      <Label fx:id="mensajeUsuario" layoutX="343.0" layoutY="54.0" prefHeight="17.0" prefWidth="220.0" text="Mensaje a usuario" />
      <VBox fx:id="vBoxExterior" layoutX="26.0" layoutY="236.0" prefHeight="44.0" prefWidth="181.0" visible="false">
         <children>
            <CheckBox fx:id="heladas" mnemonicParsing="false" onAction="#heladasPlanta" text="Heladas" />
            <CheckBox fx:id="despacho" mnemonicParsing="false" onAction="#despachoPlanta" text="Despacho" />
         </children>
      </VBox>
      <VBox fx:id="vBoxInterior" layoutX="26.0" layoutY="280.0" prefHeight="52.0" prefWidth="181.0" visible="false">
         <children>
            <TextField fx:id="volumenPlantaInterior" text="Volumen en litros" />
            <Label text="Volumen" />
         </children></VBox>
   </children>
</AnchorPane>
